# Salin menjadi .env (lokal) atau set sebagai environment variable (produksi). Jangan commit nilai asli.
# File .env dibaca oleh docker compose (database lokal) dan oleh profil dev Spring.
# Tulis nilai tanpa tanda kutip.
DB_URL=jdbc:postgresql://localhost:5432/dapurkita
DB_USER=dapurkita
# Wajib. Buat dengan: openssl rand -hex 24
DB_PASSWORD=
# Wajib, minimal 32 karakter. Buat dengan: openssl rand -hex 48
JWT_SECRET=
# Akun ADMIN pertama dibuat saat start bila belum ada (kosongkan untuk melewati)
ADMIN_EMAIL=
ADMIN_PASSWORD=
