# Salin menjadi .env atau set sebagai environment variable. Jangan commit nilai asli.
DB_URL=jdbc:postgresql://localhost:5432/dapurkita
DB_USER=dapurkita
DB_PASSWORD=dapurkita
# Wajib, minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=
# Akun ADMIN pertama dibuat saat start bila belum ada (kosongkan untuk melewati)
ADMIN_EMAIL=
ADMIN_PASSWORD=
